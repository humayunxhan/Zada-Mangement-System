{
  "name": "zada-pharmacy-spms",
  "productName": "Zada Pharmacy SPMS",
  "version": "1.0.0",
  "description": "Zada Pharmacy Supplier & Payment Management System",
  "author": "Zada Pharmacy IT Team",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "electron .",
    "build": "vite build",
    "test": "node --test electron/returns.test.cjs electron/management.test.cjs shared/export.test.cjs server/management.test.cjs",
    "server": "node server/index.js",
    "start:web": "vite build && node server/index.js",
    "app": "vite build && electron .",
    "dist:installer": "vite build && electron-builder --win nsis --x64",
    "build:php": "node scripts/build-php.mjs",
    "test:mobile": "node tests/pwa.test.mjs && node tests/mobile-flow.test.mjs"
  },
  "build": {
    "appId": "com.zadapharmacy.spms",
    "productName": "Zada Pharmacy SPMS",
    "copyright": "Copyright \u00a9 2026 Zada Pharmacy",
    "directories": {
      "output": "dist-installers"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Zada Pharmacy SPMS",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.12.0",
    "vite": "^6.1.1"
  },
  "devDependencies": {
    "electron": "^34.5.8",
    "electron-builder": "^26.0.12",
    "jsdom": "26.1.0"
  },
  "allowScripts": {
    "electron@34.5.8": true,
    "esbuild@0.25.12": true
  }
}
